# Token do bot (Discord Developer Portal > seu app > Bot > Reset Token)
DISCORD_TOKEN=cole_aqui_o_token_do_discord

# Chave da Riot (developer.riotgames.com). A de desenvolvimento expira a cada 24h.
RIOT_API_KEY=cole_aqui_a_chave_da_riot

# Servidor do LoL. Brasil = br1 e americas. (NA: na1/americas, EUW: euw1/europe)
RIOT_PLATFORM=br1
RIOT_REGION=americas

# Opcional: ID do seu servidor do Discord, para os comandos aparecerem na hora
GUILD_ID=

# De quantos em quantos minutos o bot checa se alguém entrou ou saiu de partida
INTERVALO_ALERTA_MIN=2

# Resumo semanal automático: dia (0=segunda ... 6=domingo) e hora
RESUMO_SEMANAL_DIA=6
RESUMO_SEMANAL_HORA=20

# Apostas (moedas fictícias, sem valor real)
MOEDAS_INICIAIS=1000
MOEDAS_DIARIO=250
TEMPO_APOSTAS_MIN=8

# Coleta de builds do /build (partidas Mestre+ de KR, EUW e BR).
# Desligue (COLETA_BUILDS=nao) em hospedagens com pouca memória, como a Discloud grátis.
COLETA_BUILDS=sim
COLETA_REGIOES=kr,euw,br
# Partidas por hora em cada região. 120 = ~2.900 por dia por região (~85 KB por partida: ~0,7 GB de internet por dia somando as 3 regiões)
COLETA_PARTIDAS_HORA=120
